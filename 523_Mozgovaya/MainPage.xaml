<Page x:Class="_523_Mozgovaya.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Frame x:Name="mainframe"/>
        <StackPanel Grid.Row="0" Margin="6" Orientation="Horizontal" HorizontalAlignment="Right">
            
            <ComboBox>
                <ComboBoxItem IsSelected="True">По умолчанию</ComboBoxItem>
                <ComboBoxItem>По названию</ComboBoxItem>
                <ComboBoxItem>По рейтингу</ComboBoxItem>
                <ComboBoxItem>По цене</ComboBoxItem> 
            </ComboBox>
                <TextBlock Text="поиск" FontSize="20" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="tb_search" ToolTip="введите текст для поиска" Width="250" Height="30" VerticalAlignment="Center"/>
            <Button x:Name="btn_login" Content="вход" Click="btn_login_Click" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="6" Orientation="Horizontal" VerticalAlignment="Center">
            <DataGrid Name="MyDataGrid" AutoGenerateColumns="True" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>
