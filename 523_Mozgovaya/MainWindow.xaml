<Window x:Class="_523_Mozgovaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_523_Mozgovaya"
        mc:Ignorable="d"
        Height="450" Width="800"
        Title="window"  Closing="Window_Closing" 
        >

    <Grid Background="{DynamicResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="cbTheme" Width="150" Height="30" HorizontalAlignment="Right" Margin="0,0,10,0" SelectedIndex="0" ToolTip="Выбор темы оформления" SelectionChanged="cbTheme_SelectionChanged">
            <ComboBoxItem Content="Светлая"/>
            <ComboBoxItem Content="Синяя"/>
        </ComboBox>

        <Frame x:Name="mainframe" Grid.Row="1" NavigationUIVisibility="Hidden"/>

       
    </Grid>
</Window>
