<Page x:Class="_523_Mozgovaya.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация" Background="White">
    <Grid>
        <StackPanel Margin="5">
            <Label Content="Регистрация"  HorizontalAlignment="Center" FontSize="40" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                <TextBlock Text="введите имя                           "/>
                <TextBox Width="200" ToolTip="поле для ввода имени" x:Name="tb_name"/>
            </StackPanel>
            <StackPanel Margin="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="введите фамилию                 "/>
                <TextBox Width="200" ToolTip="поле для ввода фамилии" x:Name="tb_surname"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                <TextBlock Text="введите отчество, если есть "/>
                <TextBox Width="200" ToolTip="поле для ввода отчества" x:Name="tb_lastname"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                <TextBlock Text="введите логин                       " />
                <TextBox Width="200" ToolTip="поле для ввода логина" x:Name="tb_login" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                <TextBlock Text="введите пароль                     "/>
                <PasswordBox x:Name="pas_box" Width="200" Background="WhiteSmoke" Height="30" ToolTip="поле для ввода пароля" Margin="3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="3">
                <TextBlock Text="подтвердите пароль             "/>
                <PasswordBox x:Name="pas_box2" Width="200" Background="WhiteSmoke" Height="30" ToolTip="поле для ввода пароля"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Зарегистрироваться" Width="200" Height="40" x:Name="reg_b" Click="reg_b_Click"/>
                <Button Content="назад" Width="150" Margin="20" Height="40" x:Name="back_b" Click="back_b_Click"/>
                
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
