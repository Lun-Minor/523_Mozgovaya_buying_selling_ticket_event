<Page x:Class="_523_Mozgovaya.EventPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EventPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="Black" BorderThickness="1" Margin="10" Grid.Row="0" Grid.Column="0">
              
                    <TextBlock Text="картинка_картинкакартинкакартинкакартинкакартинкакартинка" TextWrapping="Wrap"/>
               
            </Border>
            <StackPanel Grid.Column="1" Grid.Row="1" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="название" Margin="3" />
                    <Button x:Name="loved" Content="добавить в избранное" Margin="140, 0" Width="240"/>
                </StackPanel>
                    
                <TextBlock Text="описание" Height="150"/>
                <ComboBox Width="50" HorizontalAlignment="Left">
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                    <ComboBoxItem>9</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">10</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            
        </Grid>
    </Grid>
    
</Page>
