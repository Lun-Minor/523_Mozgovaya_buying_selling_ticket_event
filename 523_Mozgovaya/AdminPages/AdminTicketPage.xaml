<Page x:Class="_523_Mozgovaya.AdminPages.AdminTicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Билеты">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding cover_image}" Width="80" Height="80" Stretch="UniformToFill" Margin="0,0,15,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Покупка билетов" FontSize="13" />
                    <TextBlock x:Name="tbEventName" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Назад" Width="120" Height="35" VerticalAlignment="Center" Click="btnBack_Click"/>
            </Grid>
        </Border>


        <StackPanel Grid.Row="1">
            <TextBlock Text="Выберите сессию:" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
            <ComboBox x:Name="cbSession" Height="35" SelectionChanged="cbSession_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Location.city}"/>
                            <Run Text="{Binding Location.hall}"/>
                            <Run Text="{Binding time_start, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>


            <TextBlock Text="Выберите категорию билета:" FontSize="14" FontWeight="Bold" Margin="0,20,0,5"/>
            <ListView x:Name="lvCategories" Height="180" SelectionChanged="lvCategories_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" Width="300" DisplayMemberBinding="{Binding name}"/>
                        <GridViewColumn Header="Цена" Width="150" DisplayMemberBinding="{Binding price, StringFormat={}{0:F2} ₽}"/>
                        <GridViewColumn Header="Доступно" Width="120" DisplayMemberBinding="{Binding quantity}"/>
                    </GridView>
                </ListView.View>
            </ListView>


            <Grid Margin="0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Количество:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbQuantity" Height="35" 
                              SelectedIndex="0"
                              SelectionChanged="cbQuantity_SelectionChanged">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>

                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Льгота:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbLgot" Height="35" SelectedIndex="0" SelectionChanged="cbLgot_SelectionChanged" DisplayMemberPath="name"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10">
                    <TextBlock Text="Итоговая сумма:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="tbTotal"  FontSize="24" FontWeight="Bold"  VerticalAlignment="Center" Text="0 ₽"/>
                </StackPanel>
            </Grid>


            <Button x:Name="btnBuy" Content="Купить билеты" Height="50" Margin="0,30" FontSize="18" FontWeight="Bold" Click="btnBuy_Click"/>
        </StackPanel>
    </Grid>
</Page>
