<Page x:Class="_523_Mozgovaya.AdminPages.AdminLovedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AdminLovedPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Избранное" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Назад" Width="120" Height="35" Click="btnBack_Click"/>
        </Grid>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icFavorites">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="300" Height="380" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Grid.Row="0" Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="{Binding Rating, StringFormat='★ {0:F1}'}" Foreground="Orange" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding AgeLimit, StringFormat='  {0}+'}" FontSize="13"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="{Binding CategoryName, StringFormat='Категория: {0}'}" FontSize="12" Margin="0,5"/>
                                <TextBlock Grid.Row="4" Text="{Binding GenresText}" FontSize="12" TextWrapping="Wrap" Margin="0,5"/>


                                <Grid Grid.Row="5" Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Подробнее" Height="32" Margin="0,0,5,0" Click="btnOpen_Click" Tag="{Binding IdEvent}"/>
                                    <Button Grid.Column="1" Content="удалить" Width="70" Height="32" ToolTip="Удалить из избранного" Click="btnRemove_Click" Tag="{Binding IdEvent}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <TextBlock Grid.Row="1" x:Name="tbEmptyFavorites" Text="У вас пока нет избранных мероприятий" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>