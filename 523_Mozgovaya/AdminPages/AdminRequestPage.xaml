<Page x:Class="_523_Mozgovaya.AdminPages.AdminRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AdminRequestPage" Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Панель модерации" FontSize="26" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="Назад" Width="120" Height="35" Click="btnBack_Click"/>
        </Grid>

        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Показать:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbRequestFilter" Width="250" Height="30" SelectedIndex="0" SelectionChanged="cbRequestFilter_SelectionChanged">
                <ComboBoxItem Content="Все заявки"/>
                <ComboBoxItem Content="Только на организатора"/>
                <ComboBoxItem Content="Только мероприятия"/>
            </ComboBox>
        </StackPanel>

        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="spOrgRequests">
                    <TextBlock Text="Заявки на организатора" FontSize="18" FontWeight="Bold" Margin="5,0,0,10" />
                    <ItemsControl x:Name="icOrgRequests">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="240" Margin="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding UserName}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding OrgName, StringFormat='Организация: {0}'}" Margin="0,10"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Email, StringFormat='Email: {0}'}" Margin="0,5"/>
                                        
                                        <Grid Grid.Row="4" Margin="0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Принять" Height="30" Margin="0,0,5,0" Click="btnAcceptOrg_Click" Tag="{Binding IdRequest}"/>
                                            <Button Grid.Column="1" Content="Отклонить" Height="30" Click="btnRejectOrg_Click" Tag="{Binding IdRequest}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock x:Name="tbEmptyOrg" Text="Нет заявок на организатора" Margin="5,10,0,10" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="spEventRequests" Margin="0,20">
                    <TextBlock Text="Заявки на мероприятия" FontSize="18" FontWeight="Bold" Margin="5,0,0,10"/>
                    <ItemsControl x:Name="icEventRequests">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Height="280" Margin="5" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding EventName}" FontWeight="Bold" FontSize="16" Margin="0,10" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="{Binding OrganizerName, StringFormat='Организатор: {0}'}" Margin="0,5"/>

                                        <Grid Grid.Row="4" Margin="0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Одобрить" Height="30" Margin="0,0,5,0" Click="btnAcceptEvent_Click" Tag="{Binding IdEvent}"/>
                                            <Button Grid.Column="1" Content="Отклонить" Height="30" Click="btnRejectEvent_Click" Tag="{Binding IdEvent}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="tbEmptyEvent" Text="Нет заявок на мероприятия"  Margin="5,10,0,10" Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>