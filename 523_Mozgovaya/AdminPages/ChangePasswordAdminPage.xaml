<Page x:Class="_523_Mozgovaya.AdminPages.ChangePasswordAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePasswordAdminPage">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel Margin="5" VerticalAlignment="Center">
            <Label Content="Смена пароля" HorizontalAlignment="Center" FontSize="36" FontWeight="Bold" Margin="0,0,0,20"/>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock Text="Ваш логин:                             " VerticalAlignment="Center"/>
                <TextBox Width="200" x:Name="tb_login" IsReadOnly="True" Height="30" VerticalContentAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock Text="введите текущий пароль:      " VerticalAlignment="Center"/>
                <PasswordBox x:Name="cur_pas_box" Width="200" Background="WhiteSmoke" Height="30" Margin="3" VerticalContentAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock Text="введите новый пароль:          " VerticalAlignment="Center"/>
                <PasswordBox x:Name="pas_box" Width="200" Background="WhiteSmoke" Height="30" Margin="3" VerticalContentAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock Text="подтвердите пароль:             " VerticalAlignment="Center"/>
                <PasswordBox x:Name="pas_box2" Width="200" Background="WhiteSmoke" Height="30" Margin="3" VerticalContentAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Button Content="Сменить пароль" Width="200" Height="40" x:Name="reg_b" Click="reg_b_Click"/>
                <Button Content="Назад" Width="150" Margin="20" Height="40" x:Name="back_b" Click="back_b_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
