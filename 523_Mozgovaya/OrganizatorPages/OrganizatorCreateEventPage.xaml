<Page x:Class="_523_Mozgovaya.OrganizatorPages.OrganizatorCreateEventPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.OrganizatorPages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="OrganizatorCreateEventPage" Background="White">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

     
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Создание мероприятия" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Назад" Width="120" Height="40" Click="btnBack_Click" />
        </Grid>

        
        <Border Grid.Row="1" >
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch">

                    
                    <TextBlock Text="Основная информация" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

                    <TextBlock Text="Название*" FontSize="14" Margin="0,0,0,5" />
                    <TextBox x:Name="tbName" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" />

                    <TextBlock Text="Описание" FontSize="14" Margin="0,0,0,5" />
                    <TextBox x:Name="tbDescription" Height="80" Margin="0,0,0,15" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Возрастное ограничение" FontSize="14" Margin="0,0,0,5" />
                            <TextBox x:Name="tbAgeLimit" Height="35" VerticalContentAlignment="Center" ToolTip="Пример 8, 16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Категория*" FontSize="14" Margin="0,0,0,5" />
                            <ComboBox x:Name="cbCategory" Height="35" DisplayMemberPath="name" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Жанры" FontSize="14" Margin="0,0,0,5" />
                    <ComboBox x:Name="cbGenres" Height="35" Margin="0,0,0,15"  IsEditable="True" IsReadOnly="True" Text="Выберите жанры" DropDownClosed="cbGenres_DropDownClosed" VerticalContentAlignment="Center" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Ссылка на картинку (URL)" FontSize="14" Margin="0,0,0,5" />
                    <TextBox x:Name="tbImagePath" Height="35" Margin="0,0,0,30" VerticalContentAlignment="Center" ToolTip="Пример: https://example.com/image.jpg"/>

                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сессии и билеты" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Добавить сессию" Width="180" Height="35" Click="btnAddSession_Click" />
                    </Grid>

                    
                    <ItemsControl x:Name="icSessions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,15" >
                                    <StackPanel>
                                        <TextBlock Text="Сессия" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />

                                        
                                        <TextBlock Text="Место проведения" FontSize="14" Margin="0,0,0,5" />
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Город*" FontSize="12" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding City}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Улица*" FontSize="12" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding Street}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Дом" FontSize="12" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding House}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Зал/площадка" FontSize="12" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding Hall}" Height="30" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        
                                        <TextBlock Text="Время проведения" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Дата и время начала*" FontSize="12" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding StartTime}" Height="30" VerticalContentAlignment="Center" ToolTip="Формат: 01.11.2026 19:00"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Дата и время конца*" FontSize="12" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding EndTime}" Height="30" VerticalContentAlignment="Center" ToolTip="Формат: 01.11.2026 22:00"/>
                                            </StackPanel>
                                        </Grid>

                                        
                                        <TextBlock Text="Билеты (VIP, Партер и т.д.):" FontSize="14" Margin="0,5,0,5" />

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Название билета*" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="Цена (руб)*" FontSize="12" Margin="10"/>
                                            <TextBlock Grid.Column="2" Text="Кол-во*" FontSize="12" Margin="10"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Tickets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Name}" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="Например: VIP, Стандарт"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Price}" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBox Grid.Column="2" Text="{Binding Quantity}" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Grid.Column="3" Content="✕" Width="30" Height="30" CommandParameter="{Binding}" Click="btnRemoveTicket_Click" ToolTip="Удалить билет"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="Добавить билет" Width="160" Height="30" HorizontalAlignment="Left" Margin="0,10" CommandParameter="{Binding}" Click="btnAddTicket_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Отправить на модерацию" Height="50" FontSize="18" FontWeight="Bold" Margin="0,20" Click="btnSubmit_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>