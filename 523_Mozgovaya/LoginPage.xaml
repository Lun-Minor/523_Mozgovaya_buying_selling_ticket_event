<Page x:Class="_523_Mozgovaya.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="600"
      Title="LoginPage" Background="White">


    <Grid>
        <StackPanel Margin="10">
            <Label Content="Авторизация" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="40"/>
            <StackPanel >
                <TextBlock Text="Введите логин" HorizontalAlignment="Center"/>
                <TextBox x:Name="log_tb" Height="30" Width="200" HorizontalAlignment="Center" ToolTip="поле для ввода логина"/>
                <TextBlock Text="Введите пароль" HorizontalAlignment="Center"/>
                <PasswordBox x:Name="password_box" Height="30" Width="200" HorizontalAlignment="Center" Background="WhiteSmoke" ToolTip="поле для ввода пароля" />
            </StackPanel>

            <StackPanel Margin="20,10,10,0" Orientation="Horizontal">
                <StackPanel Margin="0,0,65,0" Orientation="Vertical">
                    <Label Content="нет аккаунта, зарегистрируйтесь" FontSize="15"/>
                    <Button x:Name="bt_reg" Content="Регистрация"  HorizontalAlignment="Left" Click="bt_reg_Click" Width="200"/>
                </StackPanel>

                <Button x:Name="back" Content="Назад" Click="back_Click" Margin="0,37" Width="150"/>
                
            </StackPanel>
            <Button Click="ButtonEnter_OnClick" Content="Войти" Width="150" x:Name="ButtonEnter"/>
        </StackPanel>


        <StackPanel x:Name="captchaPanel" Visibility="Hidden"
            Width="280"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="White"
            Panel.ZIndex="10">

            <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                <StackPanel Margin="5">
                    <Label Content="введите код с картинки"
                   FontSize="13" HorizontalAlignment="Center"/>

                    <TextBox CommandManager.PreviewExecuted="textBox_PreviewExecuted" x:Name="captcha"
                     Height="42" Foreground="Crimson" BorderThickness="1" IsReadOnly="True" HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center" FontSize="22" Margin="5"/>

                    <TextBox x:Name="captchaInput"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="" Margin="8"
                     ToolTip="Введите символы с картинки"/>

                    <Button x:Name="submitCaptcha" Content="Подтвердить" ToolTip="Подтвердить ввод капчи" Click="submitCaptcha_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Page>