<Page x:Class="_523_Mozgovaya.ClientPages.RequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_523_Mozgovaya.ClientPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Запрос на роль организатора" Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Стать организатором" FontSize="26" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="Назад" Width="120" Height="35" Click="btnBack_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Width="600" HorizontalAlignment="Left">
            <TextBlock Text="Заполните данные организации, чтобы отправить заявку администратору."  FontSize="16"  />

            <TextBlock Text="Название организации*" FontSize="14" Margin="5"/>
            <TextBox x:Name="tbOrgName" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="ИНН" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbINN" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Контактный Email*" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="tbEmail" Height="30" Margin="0,0,0,20"/>

            <Button Content="Отправить заявку" Height="45" FontSize="16" Click="btnSubmit_Click" Width="200"/>
        </StackPanel>
    </Grid>
</Page>